{
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Util\\": "util/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require": {
        "ext-pdo": "*",
        "beberlei/doctrineextensions": "^1.5",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.8",
        "doctrine/orm": "^3.3",
        "florianv/exchanger": "^2.8",
        "itsgoingd/clockwork": "^5.3",
        "lcharette/webpack-encore-twig": "^1.2",
        "league/csv": "^9.22",
        "league/flysystem": "^3.29",
        "league/flysystem-aws-s3-v3": "^3.29",
        "mbezhanov/faker-provider-collection": "^2.0",
        "mehrkanal/twig-encore-extension": "*",
        "michaelgooden/mdg-money-doctrine": "^0.4.3",
        "moneyphp/money": "^4.6",
        "php-di/php-di": "^7.0",
        "php-http/curl-client": "^2.3",
        "predis/predis": "^2.3",
        "psr/simple-cache": "^3.0",
        "ramsey/uuid": "^4.7",
        "ramsey/uuid-doctrine": "^2.1",
        "slim/csrf": "^1.5",
        "slim/psr7": "^1.7",
        "slim/slim": "4.*",
        "slim/twig-view": "^3.4",
        "symfony/cache": "^7.2",
        "symfony/console": "^7.2",
        "symfony/http-client": "^7.2",
        "symfony/mailer": "^7.2",
        "symfony/rate-limiter": "^7.2",
        "symfony/twig-bridge": "^7.2",
        "symfony/webpack-encore-bundle": "^2.2",
        "twig/intl-extra": "^3.18",
        "twig/twig": "^3.19",
        "vlucas/phpdotenv": "^5.6",
        "vlucas/valitron": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    }
}
